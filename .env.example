# 复制到当前系统用户的 ~/.kairos/.env 后填写真实值，不把真实配置提交到 Git。

# 主程序使用的协议：openai（OpenAI 兼容接口）或 anthropic（Anthropic Messages）
KAIROS_PROVIDER=openai

# Key 属于网关项目，不随 OpenAI 兼容或 Anthropic Messages 协议变化。
KAIROS_API_KEY=
# 当前网关地址；OpenAI 和 Anthropic 协议共用这个地址
GATEWAY_BASE_URL=https://api.deepseek.com

# OpenAI 兼容接口的模型名；使用网关的 Anthropic 协议时可继续填网关模型别名
KAIROS_MODEL=deepseek-flash

# Anthropic SDK 使用网关根地址，通常不带 /v1；留空时使用 GATEWAY_BASE_URL 并自动去掉末尾 /v1。
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

# 直接运行 uv run kairos 默认同时启动终端和微信，两边共用会话、记忆和工具。
# 只启用一个入口：uv run kairos --channels terminal 或 --channels weixin
# 微信首次登录：uv run --with 'qrcode[pil]' python -m kairos.wechat

# 可选：要加载的业务工具模块（JSON 数组）。不写时默认加载待办；设为 [] 不加载任何业务工具。
# 这里只配置本机已安装的可信 Python 工厂，不是 MCP 服务配置。
KAIROS_TOOL_FACTORIES=["kairos_todo.tools:build_tools"]
