# 复制成 .env 后填入真实的值。.env 已在 .gitignore 里，不会被提交。

# Agent 调试入口使用的协议：openai（OpenAI 兼容接口）或 anthropic（Anthropic Messages）
KAIROS_PROVIDER=openai

# OpenAI 兼容接口示例：当前默认使用 DeepSeek
# 也可以改用 OPENAI_API_KEY / OPENAI_BASE_URL；DEEPSEEK_* 是当前示例的兼容别名。
# 阶段 0 起需要：https://platform.deepseek.com 创建 API key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI 兼容接口的模型名；使用网关的 Anthropic 协议时可继续填网关模型别名
KAIROS_MODEL=deepseek-flash

# 选择 anthropic 时可填独立的 Anthropic key；同一网关项目 Token 也会回退使用上面的 DEEPSEEK_API_KEY。
ANTHROPIC_API_KEY=
# Anthropic SDK 使用网关根地址，通常不带 /v1；留空时会从 DEEPSEEK_BASE_URL 去掉末尾 /v1。
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096
