{
  "version": "0.2.0",
  "configurations": [


    {
      "name": "Kairos CLI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/kairos",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "Kairos Debug Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_agent.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "Kairos Tool Error Experiment",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/experiment_tool_errors.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": ["--case", "handler-error"],
      "justMyCode": true
    }
  ]
}
